import MainContent from '../components/ExperiencePage.astro';

const myJobs: Job[] = [
  {
    type: "Internship",
    company: {
		name: "pulse by solution (fka Giza Systems)",
		link: "https://pulsebysolutions.com/"
	},
    title: "Full Stack Intern | GDC",
    city: "Cairo, Egypt",
    time: "Aug 2026",
    description:
      "Built RESTful APIs with Spring Boot using a layered controller-service-repository architecture. Implemented JWT-based authentication, role-based access control, and ownership-based authorization for user-scoped resources. Integrated Angular frontend functionality with backend APIs and applied centralized exception handling and stateless security filtering.",
