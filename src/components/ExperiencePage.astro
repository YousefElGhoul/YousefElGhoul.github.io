---
interface Props {
  jobs: Job[];
}

const { jobs } = Astro.props;
import Experience, { type Job }  from '../components/JobExperience.astro';
---

<div class="bg-slate-700 grow p-16 text-slate-200  flex flex-col">
	<section id="hero" class="flex flex-col justify-center gap-5">
		<h1 id="title" class="flex flex-row text-5xl w-full">
            Experience
        </h1>
        <hr class="border-t-2 border-slate-400 my-4">
	</section>
    {jobs.map((job) => (
        <Experience job={job} />
    ))}
</div>
