      "Java",
      "Spring Boot",
      "REST APIs",
      "JWT",
      "RBAC",
      "Spring Security",
      "Angular",
      "TypeScript",
      "PostgreSQL",
      "JPA / Hibernate"
    ],
  },
  {
    type: "Internship",
    company: {
		name: "Giza Systems",
		link: "https://pulsebysolutions.com/"
	},
    title: "Software Testing Intern | EBS",
    city: "Cairo, Egypt",
    time: "Jul 2024",
    description:
      "Worked within a collaborative QA team and gained hands-on experience with the Software Development Life Cycle and Software Testing Life Cycle. Designed and executed test scenarios and test cases, reported and tracked defects, and practiced regression testing and structured QA documentation.",
    skills: [
      "Software Testing",
      "Manual Testing",
      "Test Cases",
      "Test Scenarios",
      "Bug Reporting",
      "Regression Testing",
      "SDLC",
      "STLC",
      "Quality Assurance"
    ],
  }
