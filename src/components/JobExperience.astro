---
export interface Company {
    name: string;
    link: string;
}

export interface Job {
    type: string;
    company: Company;
    title: string;
    city: string;
    time: string;
    description: string;
    skills: string[];
}

interface Props {
  job: Job;
}

const { job } = Astro.props;
---

<div id="exp" class="flex py-2">
    <h1 id="exp-type" class="p-4 uppercase text-l font-extrabold text-blue-300">
        { job.type }
    </h1>
    <div class="flex flex-col px-4 grow">
        <div id="exp-header" class="flex py-4">
            <div class="flex flex-col">
                <h1 class="text-2xl font-extrabold">
                    { job.title }
                </h1>
                <div class="flex divide-x divide-slate-400 text-slate-400">
                    <a class="px-4 hover:text-slate-200 transition duration-300 ease-in-out" href={ job.company.link } target="_blank">
                        { job.company.name }
                    </a>
                    <p class="px-4">
                        { job.city }
                    </p>
                </div>
            </div>
            <div class="grow"></div>
            <div class="text-slate-400">
                <h1>
                    { job.time }
                </h1>
            </div>
        </div>
        <div id="exp-body" class="p-4">
            <p>
                { job.description }
            </p>
        </div>
        <div class="flex divide-x divide-slate-400 text-slate-400 px-4">
            {job.skills.map((skill) => (
                <p class="px-4">{ skill }</p>
            ))}
        </div>
    </div>
</div>