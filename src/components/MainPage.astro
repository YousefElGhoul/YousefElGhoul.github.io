---
export interface Headline {
  jobTitle: string;
  expertise: string;
  technologies: string[];
}

export interface HnE {
  headline: Headline;
  education: string;
}

interface Props {
  HnE: HnE;
}

Astro.response.headers.set(
  "Content-Type",
  "text/html; charset=utf-8"
);

const { HnE } = Astro.props;
---

<div
  class="
    relative mt-16
    flex w-full flex-1 flex-col
    items-center justify-center
  "
>
  <section
    class="
      z-10
      flex min-h-full w-full flex-1 flex-col
      justify-center
      gap-8
      px-4 py-8
      md:px-16
    "
  >
    <!-- Hero -->
<div class="flex w-full flex-col xl:flex-row xl:items-start xl:gap-8">

  <!-- English side -->
  <div class="flex max-w-4xl flex-col">
    <span class="uppercase text-sm sm:text-lg">
      Hey, I'm
    </span>

    <!--
      Mobile: two lines
      Desktop: one line
    -->
    <h1
      class="
        flex flex-col
        font-extrabold leading-none
        text-5xl sm:text-6xl md:text-7xl
        xl:flex-row xl:gap-x-[0.22em] xl:text-8xl
      "
    >
      <span>Yousef</span>
      <span>El-Ghoul</span>
    </h1>

    <!-- Arabic name: MOBILE/TABLET -->
    <h2
      class="
        arabic-text
        mt-5
        text-4xl sm:text-5xl md:text-6xl
        xl:hidden
      "
    >
      يوسف الغول
    </h2>

    <p
      class="
        mt-6 max-w-xl
        text-lg leading-relaxed
        sm:text-xl md:text-2xl
      "
    >
      Software engineer who enjoys building useful things and turning ideas
      into working systems.
    </p>

    <!-- Hero buttons -->
    <div
      class="
        mt-7
        flex flex-col items-start
        gap-3
        sm:flex-row sm:items-center sm:gap-4
      "
    >
      <a
        href="/projects"
        class="
          inline-flex items-center justify-center gap-2
          rounded-xl border-2 border-page
          bg-accent px-4 py-3
          text-sm font-medium
          text-page fill-page
          transition duration-300 ease-in-out
          hover:bg-accent-hover
          sm:text-base xl:text-lg
        "
      >
        <svg
          class="h-[1.15em] w-[1.15em] shrink-0"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 -960 960 960"
        >
          <path d="M168-192q-29 0-50.5-21.5T96-264v-432q0-29.7 21.5-50.85Q139-768 168-768h216l96 96h312q29.7 0 50.85 21.15Q864-629.7 864-600v336q0 29-21.15 50.5T792-192H168Zm0-72h624v-336H450l-96-96H168v432Zm0 0v-432 432Z"/>
        </svg>

        <span>View Projects</span>

        <svg
          class="h-[1.15em] w-[1.15em] shrink-0"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 -960 960 960"
        >
          <path d="M673-446.67H160v-66.66h513l-240-240L480-800l320 320-320 320-47-46.67 240-240Z"/>
        </svg>
      </a>

      <a
        href="https://resume.yousefelghoul.dev"
        target="_blank"
        rel="noreferrer"
        class="
          inline-flex items-center justify-center gap-2
          rounded-xl border-2 border-page
          bg-black/20 px-4 py-3
          text-sm font-medium
          backdrop-blur-md
          transition duration-300 ease-in-out
          hover:bg-black/50
          sm:text-base xl:text-lg
        "
      >
        <svg
          class="h-[1.15em] w-[1.15em] shrink-0"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 -960 960 960"
        >
          <path d="M186.67-186.67h586.66V-559L559-773.33H186.67v586.66Zm0 66.67q-27.5 0-47.09-19.58Q120-159.17 120-186.67v-586.66q0-27.5 19.58-47.09Q159.17-840 186.67-840h400L840-586.67v400q0 27.5-19.58 47.09Q800.83-120 773.33-120H186.67Zm92.66-167.33h401.34V-354H279.33v66.67Zm0-159.34h401.34v-66.66H279.33v66.66Zm0-159.33h277.34v-66.67H279.33V-606Zm-92.66 419.33v-586.66 586.66Z"/>
        </svg>

        <span>Resume</span>

        <svg
          class="h-[1.15em] w-[1.15em] shrink-0"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 -960 960 960"
        >
          <path d="M246.67-244 200-290.67l402.67-402.66H236V-760h480v480h-66.67v-366.67L246.67-244Z"/>
        </svg>
      </a>
    </div>
  </div>

  <!-- Arabic name: DESKTOP ONLY -->
  <div class="ml-auto hidden pt-14 xl:block">
    <h2 class="arabic-text whitespace-nowrap text-6xl">
      يوسف الغول
    </h2>
  </div>

</div>

    <!-- Information cards -->
    <div class="flex w-full flex-col gap-4">
      <!-- Headline -->
      <article
        class="
          flex w-full items-start
          gap-4
          rounded-2xl
          border border-page/40
          bg-page/20
          p-4
          backdrop-blur-md
          transition duration-300
          hover:bg-page/30
          sm:p-5
          md:w-1/2
        "
      >
        <!-- Hidden on mobile -->
        <div
          class="
            hidden
            h-12 w-12 shrink-0
            items-center justify-center
            rounded-xl
            bg-page
            text-accent fill-accent
            md:flex
          "
        >
          <svg
            class="h-6 w-6"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 -960 960 960"
          >
            <path
              d="M370.33-524.33Q326.67-568 326.67-634t43.66-109.67Q414-787.33 480-787.33t109.67 43.66Q633.33-700 633.33-634t-43.66 109.67Q546-480.67 480-480.67t-109.67-43.66ZM160-160v-100q0-36.67 18.5-64.17T226.67-366q65.33-30.33 127.66-45.5 62.34-15.17 125.67-15.17t125.33 15.5q62 15.5 127.34 45.17 30.33 14.33 48.83 41.83T800-260v100H160Zm66.67-66.67h506.66V-260q0-14.33-8.16-27-8.17-12.67-20.5-19-60.67-29.67-114.34-41.83Q536.67-360 480-360t-111 12.17Q314.67-335.67 254.67-306q-12.34 6.33-20.17 19-7.83 12.67-7.83 27v33.33Zm315.16-345.5Q566.67-597 566.67-634t-24.84-61.83Q517-720.67 480-720.67t-61.83 24.84Q393.33-671 393.33-634t24.84 61.83Q443-547.33 480-547.33t61.83-24.84ZM480-634Zm0 407.33Z"
            />
          </svg>
        </div>

        <div class="min-w-0">
          <p
            class="
              uppercase
              text-sm font-extrabold
              text-accent
            "
          >
            Headline
          </p>

          <div
            class="
              mt-2
              flex flex-col md:flex-row
              gap-1
              text-sm
              sm:text-base
            "
          >
            <span>
              {HnE.headline.jobTitle}
            </span>
            <span class="hidden md:block"> | </span>
            <span>
              {HnE.headline.expertise}
            </span>
            <span class="hidden md:block"> | </span>
            <span>
              {HnE.headline.technologies.join(", ")}
            </span>
          </div>
        </div>
      </article>

      <!-- Education -->
      <article
        class="
          flex w-full items-start
          gap-4
          rounded-2xl
          border border-page/40
          bg-page/20
          p-4
          backdrop-blur-md
          transition duration-300
          hover:bg-page/30
          sm:p-5
          md:w-1/2
        "
      >
        <!-- Hidden on mobile -->
        <div
          class="
            hidden
            h-12 w-12 shrink-0
            items-center justify-center
            rounded-xl
            bg-page
            text-accent fill-accent
            md:flex
          "
        >
          <svg
            class="h-6 w-6"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 -960 960 960"
          >
            <path
              d="M480-120 160-280v-240L40-580l440-220 440 220-160 80v220L480-120Zm0-89 200-100v-151L480-360 280-460v151l200 100Zm0-241 268-134-268-134-268 134 268 134Z"
            />
          </svg>
        </div>

        <div class="min-w-0">
          <p
            class="
              uppercase
              text-sm font-extrabold
              text-accent
            "
          >
            Education
          </p>

          <p
            class="
              mt-2
              text-sm
              sm:text-base
            "
          >
            {HnE.education}
          </p>
        </div>
      </article>
    </div>
  </section>
</div>