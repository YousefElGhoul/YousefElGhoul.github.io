---
import ProjectCard from '../components/ProjectCard.astro';
import type { Project } from "../lib/projects";

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
---

<div class="flex flex-col grow p-8 md:p-16 bg-slate-400 dark:bg-slate-700">
	<section id="hero" class="flex flex-col justify-center">
		<h1 id="title" class="flex flex-row text-4xl md:text-5xl w-full">
            Projects
        </h1>
        <hr class="border-t-2 border-slate-700 dark:border-slate-400 my-4 md:my-9">
	</section>
    {projects.map((project) => (
        <ProjectCard project={project} />
    ))}
    {projects.length === 0 && (
        <p class="text-slate-700 dark:text-slate-400">
            No portfolio projects are currently published.
        </p>
    )}
</div>
