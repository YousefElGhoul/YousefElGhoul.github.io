---
import ProjectCard from '../components/ProjectCard.astro';
import type { Project } from "../lib/projects";

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
---

<div class="flex flex-col grow p-8 mt-16 md:p-16 z-10">
	<section id="hero" class="flex flex-col justify-center">
		<h1 id="title" class="flex flex-row text-4xl md:text-5xl w-full">
            Projects
        </h1>
        <hr class="border-t-2 border-muted my-4 md:my-9">
	</section>
    <section class="
        rounded-2xl
        border border-page/80
        bg-page/40 backdrop-blur-md
        p-6 pb-8
        transition duration-300
        hover:bg-page/50
    ">
        {projects.map((project) => (
            <ProjectCard project={project} />
        ))}
        {projects.length === 0 && (
            <p class="text-muted">
                No portfolio projects are currently published.
            </p>
        )}
    </section>
</div>
