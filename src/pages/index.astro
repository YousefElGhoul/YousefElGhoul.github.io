---
import Main from '../layouts/Main.astro';
import Header from '../components/Header.astro';
import MainContent, { type HnE } from '../components/MainPage.astro';
import Footer from '../components/Footer.astro';

const HnE: HnE = {
  headline: {
    jobTitle: "Software Engineer",
    expertise: "Backend Development",
	technologies: [
      "Java",
      "Spring Boot"
    ],
  },
  education: "B.Sc. in Computer Science and Artificial Intelligence from Capital University (fka Helwan)"
}
---
<head>
	<title>YG | Main Page</title>
</head>

<Main>
	<Header />
	<MainContent HnE={HnE} />
	<Footer />
</Main>
