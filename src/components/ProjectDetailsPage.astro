---
import type { Project } from "../lib/projects";
import { renderProjectReadme } from "../lib/projects/readme";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const readmeHtml = await renderProjectReadme(project);

const statusColorMap: Record<Project['status'], string> = {
  Active: 'text-orange-800 dark:text-orange-400',
  Completed: 'text-green-800 dark:text-green-400',
  Maintained: 'text-lime-800 dark:text-lime-400',
  Archived: 'text-gray-800 dark:text-gray-400',
  Planned: 'text-yellow-800 dark:text-yellow-400',
};
---

<main class="flex flex-col grow p-8 md:p-16 bg-slate-400 dark:bg-slate-700">
  <a
    href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/projects/`}
    class="mb-6 text-slate-700 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-200 transition duration-300 ease-in-out"
  >
    <span class="material-symbols-outlined">arrow_back</span> Projects
  </a>

  <header class="flex flex-col xl:flex-row xl:gap-8">
    <p class="xl:py-4 uppercase text-l font-extrabold text-blue-900 dark:text-blue-300 min-w-3xs">
      {project.category.join(', ')}
    </p>
    <div class="grow xl:py-4">
      <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
        <h1 class="text-4xl md:text-5xl font-extrabold">{project.title}</h1>
        <span class="grow"></span>
        <p class="text-slate-700 dark:text-slate-400">{project.year}</p>
      </div>
      <div class="flex flex-wrap items-center gap-x-4 gap-y-1 pt-1">
        <p class="text-lg text-slate-700 dark:text-slate-400">{project.subtitle}</p>
        <span class="grow"></span>
        <p class:list={["font-extrabold", statusColorMap[project.status]]}>{project.status}</p>
      </div>
      <p class="py-6">{project.description}</p>
      <div class="flex flex-wrap gap-x-5 gap-y-2 text-slate-700 dark:text-slate-400">
        <a href={project.repository.link} target="_blank" rel="noreferrer" class="hover:text-slate-900 dark:hover:text-slate-200 transition duration-300 ease-in-out">
          {project.repository.provider} <span class="material-symbols-outlined">arrow_outward</span>
        </a>
        {project.live && (
          <a href={project.live} target="_blank" rel="noreferrer" class="hover:text-slate-900 dark:hover:text-slate-200 transition duration-300 ease-in-out">
            Live <span class="material-symbols-outlined">arrow_outward</span>
          </a>
        )}
      </div>
      <p class="pt-4 text-slate-700 dark:text-slate-400">{project.technologies.join(', ')}</p>
    </div>
  </header>

  <hr class="border-t-2 border-slate-700 dark:border-slate-400 my-8" />
  <article class="readme min-w-0 w-full max-w-5xl break-words" set:html={readmeHtml} />
</main>

<style>
  @reference "../styles/global.css";

  .readme :global(h1) { @apply text-3xl md:text-4xl font-extrabold mt-10 mb-4; }
  .readme :global(h2) { @apply text-2xl md:text-3xl font-bold mt-9 mb-3 border-b border-slate-700 dark:border-slate-400 pb-2; }
  .readme :global(h3) { @apply text-xl md:text-2xl font-bold mt-7 mb-2; }
  .readme :global(h4) { @apply text-lg font-bold mt-6 mb-2; }
  .readme :global(p) { @apply my-4 leading-7; }
  .readme :global(a) { @apply underline text-blue-900 dark:text-blue-300 hover:text-blue-700 dark:hover:text-blue-200; }
  .readme :global(ul) { @apply list-disc pl-7 my-4; }
  .readme :global(ol) { @apply list-decimal pl-7 my-4; }
  .readme :global(li) { @apply my-1; }
  .readme :global(blockquote) { @apply border-l-4 border-slate-700 dark:border-slate-400 pl-4 text-slate-700 dark:text-slate-400; }
  .readme :global(code) { @apply rounded bg-slate-300 dark:bg-slate-800 px-1.5 py-0.5 text-sm; }
  .readme :global(pre) { @apply overflow-x-auto rounded bg-slate-300 dark:bg-slate-800 p-4 my-5; }
  .readme :global(pre code) { @apply bg-transparent p-0; }
  .readme :global(table) { @apply block overflow-x-auto w-full border-collapse my-5; }
  .readme :global(th), .readme :global(td) { @apply border border-slate-700 dark:border-slate-400 px-3 py-2 text-left; }
  .readme :global(img) { @apply max-w-full h-auto my-5; }
  .readme :global(hr) { @apply border-slate-700 dark:border-slate-400 my-8; }
</style>
