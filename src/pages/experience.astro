---
import Main from '../layouts/Main.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MainContent from '../components/ExperiencePage.astro';


const response = await fetch('https://resume.yousefelghoul.dev/experience.json');
const myJobs = await response.json();
---
<Main
	title="Experience | Yousef El-Ghoul"
	description="Software engineering experience and internships of Yousef El-Ghoul, covering backend development, full-stack development, and software testing."
>
	<Header />
	<MainContent jobs={myJobs} />
	<Footer />
</Main>
