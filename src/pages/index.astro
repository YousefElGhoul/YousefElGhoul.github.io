---
import Main from '../layouts/Main.astro';
import Header from '../components/Header.astro';
import MainContent from '../components/MainPage.astro';
import Footer from '../components/Footer.astro';

const response = await fetch('https://resume.yousefelghoul.dev/hne.json');
const HnE = await response.json();
---
<head>
	<title>YG | Main Page</title>
</head>

<Main>
	<Header />
	<MainContent HnE={HnE} />
	<Footer />
</Main>
