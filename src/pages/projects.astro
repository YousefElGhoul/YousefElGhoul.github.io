---
import Main from '../layouts/Main.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MainContent from '../components/ProjectsPage.astro';
import { getProjects } from '../lib/projects';

const myProjects = await getProjects();
---
<Main
	title="Projects | Yousef El-Ghoul"
	description="Selected software engineering projects by Yousef El-Ghoul, including backend systems, full-stack applications, developer tooling, and infrastructure projects."
>
	<Header />
	<MainContent projects={myProjects} />
	<Footer />
</Main>
